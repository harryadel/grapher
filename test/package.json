{
  "name": "test",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "test": "TEST_BROWSER_DRIVER=puppeteer meteor test-packages --once --driver-package meteortesting:mocha ../",
    "test:watch": "TEST_BROWSER_DRIVER=puppeteer meteor test-packages --driver-package meteortesting:mocha ../",
    "test:client:watch": "TEST_SERVER=0 TEST_BROWSER_DRIVER=puppeteer meteor test-packages --driver-package meteortesting:mocha ../",
    "test:server:watch": "TEST_CLIENT=0 meteor test-packages --driver-package meteortesting:mocha ../"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.1",
    "@types/meteor": "^2.9.8",
    "chai": "^5.2.0",
    "meteor-node-stubs": "^1.2.17"
  },
  "devDependencies": {
    "puppeteer": "^24.8.2"
  },
  "volta": {
    "node": "22.15.0"
  }
}
